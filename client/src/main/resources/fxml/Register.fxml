<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.proftest.client.controller.RegisterController"
            styleClass="root-pane">

    <VBox alignment="CENTER" spacing="14"
          AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20"
          AnchorPane.leftAnchor="40" AnchorPane.rightAnchor="40">

        <Label text="Регистрация" styleClass="section-title"/>

        <GridPane hgap="10" vgap="8" maxWidth="440">
            <columnConstraints>
                <ColumnConstraints minWidth="130"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Логин *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="loginField" promptText="Логин" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Пароль *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <PasswordField fx:id="passwordField" promptText="Минимум 6 символов" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Повторите пароль *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Повторите пароль" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="ФИО *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="fullNameField" promptText="Полное имя" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="Email *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="emailField" promptText="email@example.com" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <Label text="Телефон" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <TextField fx:id="phoneField" promptText="+375-XX-XXX-XX-XX" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

            <Label text="Подразделение" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
            <TextField fx:id="departmentField" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

            <Label text="Должность" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
            <TextField fx:id="positionField" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
        </GridPane>

        <Label fx:id="statusLabel" text="" styleClass="status-label" wrapText="true"/>

        <HBox spacing="10" alignment="CENTER">
            <Button text="Назад" onAction="#handleBack" styleClass="btn-secondary"/>
            <Button fx:id="registerButton" text="Зарегистрироваться" onAction="#handleRegister" styleClass="btn-primary"/>
        </HBox>
    </VBox>
</AnchorPane>
