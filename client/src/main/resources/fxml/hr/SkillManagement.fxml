<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.proftest.client.controller.hr.SkillManagementController"
            styleClass="root-pane">

    <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" spacing="10">

        <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="12">
            <Button text="← Назад" onAction="#handleBack" styleClass="btn-secondary-small"/>
            <Label text="Навыки" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel" styleClass="status-label"/>
        </HBox>

        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="toolbar">
            <TextField fx:id="searchField" promptText="Поиск..." prefWidth="220" styleClass="text-field"/>
            <Button text="Обновить" onAction="#handleRefresh" styleClass="btn-secondary-small"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Добавить" onAction="#handleCreate" styleClass="btn-primary-small"/>
            <Button text="Редактировать" onAction="#handleEdit" styleClass="btn-secondary-small"/>
            <Button text="Удалить" onAction="#handleDelete" styleClass="btn-danger-small"/>
        </HBox>

        <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="60"/>
                <TableColumn fx:id="nameCol" text="Навык" prefWidth="240"/>
                <TableColumn fx:id="categoryCol" text="Категория" prefWidth="180"/>
                <TableColumn fx:id="difficultyCol" text="Сложность" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>
</AnchorPane>
