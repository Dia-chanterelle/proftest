<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.proftest.client.controller.hr.TestManagementController"
            styleClass="root-pane">

    <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" spacing="10">

        <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="12">
            <Button text="← Назад" onAction="#handleBack" styleClass="btn-secondary-small"/>
            <Label text="Управление тестами" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel" styleClass="status-label"/>
        </HBox>

        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="toolbar">
            <TextField fx:id="searchField" promptText="Поиск..." prefWidth="220" styleClass="text-field"/>
            <Button text="Обновить" onAction="#handleRefresh" styleClass="btn-secondary-small"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Создать" onAction="#handleCreateTest" styleClass="btn-primary-small"/>
            <Button text="Редактировать" onAction="#handleEditTest" styleClass="btn-secondary-small"/>
            <Button text="Вкл/Выкл" onAction="#handleToggleActive" styleClass="btn-warning-small"/>
            <Button text="Вопросы теста" onAction="#handleManageQuestions" styleClass="btn-secondary-small"/>
            <Button text="Удалить" onAction="#handleDeleteTest" styleClass="btn-danger-small"/>
        </HBox>

        <TableView fx:id="testsTable" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="60"/>
                <TableColumn fx:id="titleCol" text="Название" prefWidth="280"/>
                <TableColumn fx:id="timeLimitCol" text="Время (мин)" prefWidth="100"/>
                <TableColumn fx:id="passingScoreCol" text="Порог (%)" prefWidth="90"/>
                <TableColumn fx:id="activeCol" text="Активен" prefWidth="80"/>
                <TableColumn fx:id="creatorCol" text="Создал" prefWidth="110"/>
                <TableColumn fx:id="skillsCol" text="Навыки" prefWidth="200"/>
            </columns>
        </TableView>
    </VBox>
</AnchorPane>
