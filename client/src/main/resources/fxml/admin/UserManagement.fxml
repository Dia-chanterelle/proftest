<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.proftest.client.controller.admin.UserManagementController"
            styleClass="root-pane">

    <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" spacing="10">

        <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="12">
            <Button text="← Назад" onAction="#handleBack" styleClass="btn-secondary-small"/>
            <Label text="Управление пользователями" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel" styleClass="status-label"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="toolbar">
            <TextField fx:id="searchField" promptText="Поиск по логину или имени..." prefWidth="280" styleClass="text-field"/>
            <Button text="Обновить" onAction="#handleRefresh" styleClass="btn-secondary-small"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Добавить" onAction="#handleAddUser" styleClass="btn-primary-small"/>
            <Button text="Активировать/Блокировать" onAction="#handleToggleActive" styleClass="btn-warning-small"/>
            <Button text="Изменить роль" onAction="#handleSetRole" styleClass="btn-secondary-small"/>
            <Button text="Удалить" onAction="#handleDeleteUser" styleClass="btn-danger-small"/>
        </HBox>

        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="60"/>
                <TableColumn fx:id="loginCol" text="Логин" prefWidth="130"/>
                <TableColumn fx:id="fullNameCol" text="ФИО" prefWidth="200"/>
                <TableColumn fx:id="emailCol" text="Email" prefWidth="180"/>
                <TableColumn fx:id="activeCol" text="Активен" prefWidth="80"/>
                <TableColumn fx:id="rolesCol" text="Роли" prefWidth="200"/>
            </columns>
        </TableView>
    </VBox>
</AnchorPane>
